<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>contract.validation.it</groupId><artifactId>generation-defects</artifactId><version>1</version>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <python.sources>valid</python.sources>
    </properties>
    <build><plugins>
        <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        </plugin>
        <plugin>
            <groupId>io.github.ih0r-d</groupId><artifactId>polyglot-codegen-maven-plugin</artifactId><version>@project.version@</version>
            <configuration>
                <inputDirectory>${project.basedir}/${python.sources}</inputDirectory>
                <basePackage>consumer.generated</basePackage><strictMode>true</strictMode>
            </configuration>
            <executions><execution><goals><goal>generate</goal></goals></execution></executions>
        </plugin>
    </plugins></build>
</project>
