String log = new String(java.nio.file.Files.readAllBytes(new File(basedir, "build.log").toPath()), java.nio.charset.StandardCharsets.UTF_8);
for (String expected : new String[] { "keyword-only", "Python set" }) {
    if (!log.contains(expected)) throw new AssertionError("Missing diagnostic: " + expected);
}
if (!new File(basedir, "target/classes/consumer/Consumer.class").isFile()) throw new AssertionError("Consumer did not compile");
String generated = new String(java.nio.file.Files.readAllBytes(new File(basedir, "target/generated-sources/polyglot/consumer/generated/Api.java").toPath()), java.nio.charset.StandardCharsets.UTF_8);
if (!generated.contains("hello(String name)") || generated.contains("ault(") || generated.contains("nested(") || generated.contains("from_docstring(")) throw new AssertionError("Incorrect generated methods");
return true;
